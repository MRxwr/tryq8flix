# Apache fallback for the web build deployed at https://tryq8flix.com/tv-app/dist-web/
# Deep links (/tv-app/dist-web/live, /tv-app/dist-web/favorites, ...) are handled by
# the React router, so every unknown path here is served the app shell.
# If the build is uploaded elsewhere, change both paths below to match.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /tv-app/dist-web/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /tv-app/dist-web/index.html [L]
</IfModule>
