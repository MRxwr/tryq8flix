# Used by `npm run build:web` (vite build --mode tvweb).
# The whole repository is deployed to https://tryq8flix.com/tv-app/, so the built
# app lives one level down and is served from /tv-app/dist-web/.
# Assets therefore resolve under /tv-app/dist-web/ and API calls stay same-origin,
# because the website sends no CORS headers (a copy on another domain is blocked).
TV_BASE=/tv-app/dist-web/
VITE_SAME_ORIGIN_API=1
