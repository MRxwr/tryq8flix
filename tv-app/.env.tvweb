# Used by `npm run build:web` (vite build --mode tvweb).
# Builds the TV app for https://tryq8flix.com/tv-app/.
# Assets resolve under /tv-app/ and API calls stay same-origin, because the
# website sends no CORS headers (a copy on another domain would be blocked).
TV_BASE=/tv-app/
VITE_SAME_ORIGIN_API=1
